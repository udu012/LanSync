<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/cardBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:contentDescription="返回"
            android:text="←"
            android:textColor="@color/textMain"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="使用说明"
            android:textColor="@color/textMain"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EAEF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pageBg" />

        <!-- 极少数 ROM 的 WebView 组件会白屏，这里给个能看懂的文字兜底 -->
        <ScrollView
            android:id="@+id/fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pageBg"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="这台手机的网页组件暂时打不开图文说明"
                    android:textColor="@color/textMain"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="不影响同步功能。先照着下面三步走，图文的完整版在电脑上：LanSync 目录里的「使用说明.png」。"
                    android:textColor="@color/textMuted"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="6dp"
                    android:text="1. 电脑上双击 LanSync.exe，允许防火墙（勾「专用网络」）\n\n2. 把接收目录改到 D 盘：看板「概览」里点接收目录后面的「更改」\n\n3. 回到本页点「扫描电脑二维码」，对准电脑屏幕上的二维码\n\n4. 手机设置里把 LanSync 的「自启动」「后台运行」打开，电池策略设为「不限制」"
                    android:textColor="@color/textMain"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
